@using REVAACOURSES.Models
@model List<Course>

@{
    ViewData["Title"] = "";
}

<!-- Navbar -->


<!-- Hero -->
<header class="hero-section">
    <div class="container text-center text-white py-5">
        <h1 class="display-4 fw-bold">
            Learn Without Limits
        </h1>

        <p class="lead">
            Discover thousands of courses and improve your skills.
        </p>
    </div>
</header>

<!-- Filter -->
<section class="py-4 filter-bar">
    <div class="container">

        <form>
            <div class="row justify-content-center align-items-center g-3">

                <div class="col-md-2">
                    <input type="text"
                           class="form-control"
                           placeholder="Title"
                           name="Title"
                           value="@ViewBag.Title">
                </div>

                <div class="col-md-2">
                    <input type="number"
                           class="form-control"
                           placeholder="Price"
                           name="Price"
                           value="@ViewBag.Price">
                </div>

                <div class="col-md-2">
                    <input type="date"
                           class="form-control"
                           name="CreatedAt"
                           value="@ViewBag.CreatedAt">
                </div>

                <div class="col-md-2">
                    <select name="CategoryId" class="form-select">
                        <option>--Select Category--</option>

                        @foreach (var item in ViewBag.Categories)
                        {
                            @if (item.CategoryId == ViewBag.CategoryId)
                            {
                                <option value="@item.CategoryId" selected>
                                    @item.Name
                                </option>
                            }
                            else
                            {
                                <option value="@item.CategoryId">
                                    @item.Name
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <button type="submit" class="btn btn-dark w-100">
                        Filter
                    </button>
                </div>
            </div>
        </form>

    </div>
</section>

<!-- Courses -->
<section class="py-5">

    <div class="container">

        <h2 class="fw-bold mb-4">
            Popular Courses
        </h2>

        <div class="row g-4">

            @foreach (var item in Model)
            {
                <div class="col-lg-3 col-md-6">

                    <div class="course-card shadow-sm">

                        <div class="position-relative">

                            <img src="~/Images/CourseImages/@item.Img"
                                 class="course-img"
                                 alt="@item.Title" />

                            @if (item.Category != null)
                            {
                                <span class="category-badge">
                                    @item.Category.Name
                                </span>
                            }

                        </div>

                        <div class="p-3">

                            <h5 class="fw-bold">
                                @item.Title
                            </h5>

                            <p class="text-muted small description">
                                @(string.IsNullOrWhiteSpace(item.Description)
                                    ? "No description available"
                                    : item.Description)
                            </p>

                            <div class="rating">
                                ⭐⭐⭐⭐⭐
                                <span>4.8</span>
                            </div>

                            <h5 class="fw-bold text-primary mt-2">
                                $ @item.Price
                            </h5>

                            <p class="small text-muted">
                                Added: @item.CreatedAt.ToString("MM/dd/yyyy")
                            </p>

                            <a asp-area="Customer"
                               asp-controller="Home"
                               asp-action="CourseDetails"
                               asp-route-id="@item.Id"
                               class="btn btn-primary w-100">
                                View Course
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>

    </div>

</section>

<!-- Pagination -->
<section>
    <nav aria-label="Page navigation example">
        <div class="d-flex justify-content-center align-items-center">
            <ul class="pagination">

                <!-- Previous -->
                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-area="Customer"
                       asp-controller="Home"
                       asp-action="Index"
                       asp-route-page="@(ViewBag.CurrentPage - 1)"
                       asp-route-Title="@ViewBag.Title"
                       asp-route-Price="@ViewBag.Price"
                       asp-route-CreatedAt="@ViewBag.CreatedAt"
                       asp-route-CategoryId="@ViewBag.CategoryId">
                        Previous
                    </a>
                </li>

                <!-- Page Numbers -->
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                        <a class="page-link"
                           asp-area="Customer"
                           asp-controller="Home"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-Title="@ViewBag.Title"
                           asp-route-Price="@ViewBag.Price"
                           asp-route-CreatedAt="@ViewBag.CreatedAt"
                           asp-route-CategoryId="@ViewBag.CategoryId">
                            @i
                        </a>
                    </li>
                }

                <!-- Next -->
                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-area="Customer"
                       asp-controller="Home"
                       asp-action="Index"
                       asp-route-page="@(ViewBag.CurrentPage + 1)"
                       asp-route-Title="@ViewBag.Title"
                       asp-route-Price="@ViewBag.Price"
                       asp-route-CreatedAt="@ViewBag.CreatedAt"
                       asp-route-CategoryId="@ViewBag.CategoryId">
                        Next
                    </a>
                </li>

            </ul>
        </div>
    </nav>
</section>
<style>

    .hero-section {
        background: linear-gradient(135deg,#111827,#2563eb);
    }

    .filter-bar {
        background: #f8fafc;
    }

    .course-card {
        background: white;
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid #eee;
        transition: .3s;
        height: 100%;
    }

        .course-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px #ddd;
        }

    .course-img {
        width: 100%;
        height: 190px;
        object-fit: cover;
    }

    .category-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        background: #2563eb;
        color: white;
        border-radius: 20px;
        padding: 6px 12px;
        font-size: 12px;
    }

    .description {
        height: 45px;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .rating {
        color: #f59e0b;
    }

</style>