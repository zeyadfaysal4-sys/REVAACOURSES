﻿@using REVAACOURSES.ViewModels
@model RelatedWithCourse

<section class="py-5">
    <div class="container px-4 px-lg-5 my-5">
        <div class="row gx-4 gx-lg-5 align-items-center">

            <div class="col-md-6">
                <img class="course-details-img"
                     src="~/Images/CourseImages/@Model.Course.Img"
                     alt="@Model.Course.Title" />
            </div>

            <div class="col-md-6">

                <div class="small mb-1">
                    @Model.Course.Category.Name
                </div>

                <h1 class="display-5 fw-bolder">
                    @Model.Course.Title
                </h1>

                <span class="course-price">
                    $ @Model.Course.Price
                </span>

                <p class="lead mt-3">
                    @Model.Course.Description
                </p>

                <form asp-action="AddToCart" asp-controller="Cart">
                    <input name="courseId" value="@Model.Course.Id" hidden />

                    <button class="btn btn-outline-dark" type="submit">
                        <i class="bi-cart-fill me-1"></i>
                        Add to cart
                    </button>
                </form>

            </div>

        </div>
    </div>
</section>


<h3 class="fw-bold mt-3 mb-4">
    Student Reviews
</h3>


@if (Model.Reviews.Any())
{
    foreach (var review in Model.Reviews)
    {
        <div class="review-card mb-4">

            <div class="d-flex align-items-start gap-3">

                <div class="review-avatar">
                    @(review.Student.User.Name.Substring(0, 1).ToUpper())
                </div>


                <div class="flex-grow-1">

                    <h6 class="fw-bold">
                        @review.Student.User.Name
                    </h6>


                    <div class="rating mb-2">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= review.Rating)
                            {
                                <span class="star filled">★</span>
                            }
                            else
                            {
                                <span class="star empty">☆</span>
                            }
                        }

                        <span class="rating-number">
                            @review.Rating / 5
                        </span>
                    </div>


                    <p class="review-text">
                        @review.Comment
                    </p>

                </div>

            </div>

        </div>
    }
}
else
{
    <div class="alert alert-light">
        No reviews yet.
    </div>
}



<section class="py-5 bg-light">

    <div class="container px-4 px-lg-5 mt-5">

        <h2 class="fw-bolder mb-4">
            Related Courses
        </h2>


        <div class="row gx-4 gx-lg-5 row-cols-2 row-cols-md-3 row-cols-xl-4 justify-content-center">

            @foreach (var item in Model.RelatedCourses)
            {
                <div class="col mb-5">

                    <div class="card h-100">

                        <div class="badge bg-dark text-white position-absolute"
                             style="top:.5rem;right:.5rem">
                            @item.Category.Name
                        </div>


                        <img class="card-img-top"
                             src="~/Images/CourseImages/@item.Img"
                             alt="@item.Title" />


                        <div class="card-body p-4">

                            <div class="text-center">

                                <h5 class="fw-bolder">
                                    @item.Title
                                </h5>

                                <span class="course-price-card">
                                    $ @item.Price
                                </span>

                            </div>

                        </div>


                        <div class="card-footer p-4 pt-0 border-top-0 bg-transparent">

                            <form asp-action="AddToCart" asp-controller="Cart">

                                <input name="courseId"
                                       value="@item.Id"
                                       hidden />

                                <div class="text-center">

                                    <button class="btn btn-outline-dark">
                                        Add to cart
                                    </button>

                                </div>

                            </form>

                        </div>

                    </div>

                </div>
            }

        </div>

    </div>

</section>


<style>

    .course-details-img {
        width: 100%;
        height: 420px;
        object-fit: cover;
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(0,0,0,.15);
    }


    .course-price {
        font-size: 32px;
        font-weight: bold;
        color: #2563eb;
    }


    .review-card {
        background: white;
        border-radius: 15px;
        padding: 20px;
        border: 1px solid #e5e7eb;
    }


    .review-avatar {
        width: 55px;
        height: 55px;
        border-radius: 50%;
        background: #111827;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        font-weight: bold;
    }


    .star {
        color: #ccc;
        font-size: 20px;
    }


        .star.filled {
            color: #f59e0b;
        }


    .rating-number {
        color: #666;
        font-size: 14px;
        margin-left: 8px;
    }


    .review-text {
        color: #333;
        line-height: 1.7;
    }


    .card {
        border-radius: 15px;
        overflow: hidden;
        border: none;
        box-shadow: 0 5px 15px rgba(0,0,0,.08);
    }


        .card img {
            height: 200px;
            object-fit: cover;
        }


    .course-price-card {
        color: #2563eb;
        font-weight: bold;
        font-size: 18px;
    }

</style>